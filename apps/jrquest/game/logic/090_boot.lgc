// Room 90: the cold open. A DOS date prompt on a text screen, then the
// title. Puzzle 0: a two-digit year gets "Invalid date", as real DOS does.
#include "defines.h"

if (isset(newRoom)) {
  text.screen();
  status.line.off();
  prevent.input();
  set.text.attribute(7, 0);
  clear.lines(0, 24, 0);
  display(1, 0, "Current date is Tue  1-01-1980");
  state = 0;
  work = 2;
  tries = 0;
}

if (state == 0) {
  // get.string takes a fixed row, so the first three tries are spelled out.
  if (tries == 0) { get.string(s1, "Enter new date (mm-dd-yy): ", 2, 0, 12); }
  if (tries == 1) { get.string(s1, "Enter new date (mm-dd-yy): ", 4, 0, 12); }
  if (tries == 2) { get.string(s1, "Enter new date (mm-dd-yy): ", 6, 0, 12); }
  if (tries > 2) {
    clear.lines(8, 9, 0);
    get.string(s1, "Enter new date (mm-dd-yy): ", 8, 0, 12);
  }
  // Typing DEBUG here skips the opening, for the test scripts.
  set.string(s2, "debug");
  if (compare.strings(s1, s2)) {
    set(debugOn);
    dateMonth = 10;
    dateDay = 5;
    dateYear = 46;
    set(introDone);
    set(dateDone);
    set.text.attribute(15, 0);
    graphics();
    status.line.on();
    arriveFrom = 0;
    new.room(1);
  }
  str.date(s1, dateResult);
  if (dateResult == 1) {
    state = 1;
  }
  else {
    if (tries == 0) { display(3, 0, "Invalid date"); }
    if (tries == 1) { display(5, 0, "Invalid date"); }
    if (tries == 2) {
      display(7, 0, "Invalid date");
      // After three tries, say what DOS never would.
      display(12, 0, "(Real DOS wants all four digits of the\n year after 1999. Try 10-05-2026.)");
    }
    if (tries > 2) { display(9, 0, "Invalid date"); }
    tries++;
  }
}

if (state == 1) {
  set(dateDone);
  score += 2;
  set.text.attribute(15, 0);
  graphics();
  new.room(98);
}
return();

