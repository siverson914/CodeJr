10 REM MATH GAME FOR THE PCJR
20 SCREEN 0: WIDTH 40: COLOR 15,1: CLS
30 RANDOMIZE TIMER
40 PRINT "*** PCJR MATH GAME ***"
50 PRINT
60 PRINT "1) EASY   (NUMBERS 1-10)"
70 PRINT "2) MEDIUM (NUMBERS 1-20)"
80 PRINT "3) HARD   (NUMBERS 1-50)"
90 PRINT
100 PRINT "PICK A LEVEL (1-3): ";
110 K$=INKEY$: IF K$<"1" OR K$>"3" THEN 110
120 PRINT K$: MX=VAL(K$): IF MX=1 THEN MX=10 ELSE IF MX=2 THEN MX=20 ELSE MX=50
130 SC=0: N=10
140 FOR Q=1 TO N
150 A=INT(RND*MX)+1: B=INT(RND*MX)+1: OP=INT(RND*3)
160 IF OP=0 THEN O$="+": C=A+B
170 IF OP=1 THEN O$="-": IF B>A THEN T=A: A=B: B=T
180 IF OP=1 THEN C=A-B
190 IF OP=2 THEN O$="X": A=INT(RND*10)+1: C=A*B
200 PRINT
210 COLOR 14,1: PRINT "QUESTION";Q;"OF";N: COLOR 15,1
220 PRINT A;O$;B;"= ";
230 INPUT "",G
240 IF G=C THEN 280
250 COLOR 12,1: PRINT "NOPE! THE ANSWER IS";C: COLOR 15,1
260 SOUND 110,6
270 GOTO 310
280 COLOR 10,1: PRINT "CORRECT!": COLOR 15,1
290 SC=SC+1
300 SOUND 784,2: SOUND 1047,3
310 NEXT Q
320 PRINT
330 COLOR 11,1: PRINT "YOU GOT";SC;"OUT OF";N
340 IF SC=N THEN PRINT "PERFECT SCORE! WOW!" ELSE IF SC>=7 THEN PRINT "GREAT JOB!" ELSE PRINT "KEEP PRACTICING!"
350 COLOR 15,1: PRINT
360 PRINT "PLAY AGAIN (Y/N)? ";
370 K$=INKEY$: IF K$="" THEN 370
380 IF K$="Y" OR K$="y" THEN CLS: GOTO 40
390 PRINT: WIDTH 80: COLOR 7,0: CLS: END
